# ---------------------------------------------------------------------------
# One Postgres instance, two schemas (see docs/decisions.md).
# `payload` schema — CMS-managed tables. `app` schema — everything else
# (audit log, form results, users/permissions, AI prompts, analytics).
# Both adapters connect with the same URL; each is configured to scope
# itself to its own schema.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://localhost:5432/ai_chassis_dev

# ---------------------------------------------------------------------------
# Auth.js (v5)
# ---------------------------------------------------------------------------
AUTH_SECRET=
# Username/password (Credentials provider) is the default admin login and
# needs no env vars — it checks the `password_hash` column on `User`. Seed
# the first admin with `pnpm seed:admin <email> <password>` (see README).

# Microsoft Entra ID — optional, additional provider. Leave blank to run
# with Credentials only. Add others per-project as needed; Auth.js ships
# ~80 providers, this is just the one carried over from the original project.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# ---------------------------------------------------------------------------
# Generic OIDC identity provider — optional. Unset (default): only
# Credentials (+ Entra ID, if configured) appear on /admin/login. Set
# AUTH_OIDC_ISSUER to add any OIDC-compliant IdP (Keycloak, Authentik, Okta,
# Auth0, Zitadel, Google Workspace) — see README "Identity providers
# (opt-in)". Callback URL to register: <NEXT_PUBLIC_SERVER_URL>/api/auth/callback/oidc
# ---------------------------------------------------------------------------
AUTH_OIDC_ISSUER=
AUTH_OIDC_ID=
AUTH_OIDC_SECRET=
AUTH_OIDC_NAME=          # login button label, defaults to "Single sign-on"

# Providers whose email claim may link an IdP account to an existing User
# when the provider sends no email_verified claim. Comma-separated.
# Defaults to microsoft-entra-id when unset; set to empty to trust none.
AUTH_TRUSTED_EMAIL_PROVIDERS=

# ---------------------------------------------------------------------------
# Payload CMS
# ---------------------------------------------------------------------------
PAYLOAD_SECRET=
PREVIEW_SECRET=

# ---------------------------------------------------------------------------
# AI provider (pluggable via the Vercel AI SDK — see lib/ai/provider.ts).
# Only the variables for whichever provider you actually configure are
# required; this lists the common ones.
# ---------------------------------------------------------------------------
AI_PROVIDER=openai
AI_PROVIDER_FALLBACK_ORDER= #comma-separated, e.g. groq,google,openrouter
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# RAG (optional — direct content injection is the default knowledge
# provider and needs none of this; only required if a project opts into
# payloadcms-vectorize for larger content volumes. See docs/decisions.md).
# ---------------------------------------------------------------------------
RAG_ENABLED=false

# ---------------------------------------------------------------------------
# Web search fallback — optional. Unset (default): the concierge only ever
# answers from the knowledge provider above (direct injection or RAG); a
# query that finds nothing there just gets no context. Set WEB_SEARCH_PROVIDER
# + that provider's key(s) to fall back to a live web search instead (see
# lib/knowledge/webSearch.ts) — most useful with RAG, whose similarity
# search can legitimately come back empty for questions outside the
# indexed content.
# ---------------------------------------------------------------------------
WEB_SEARCH_PROVIDER=tavily #tavily | google
TAVILY_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ---------------------------------------------------------------------------
# Storage — optional. Unset (default): media stays on local disk under
# public/media. Set STORAGE_BUCKET (+ credentials) to switch Media uploads
# to S3-compatible storage instead (AWS S3, R2, Spaces, MinIO, etc. — see
# payload.config.ts's s3Storage wiring). STORAGE_ENDPOINT only needed for
# non-AWS S3-compatible targets.
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=

# ---------------------------------------------------------------------------
# Social publish webhook — optional. Unset (default): publishing a Page or
# Post does nothing extra. Set SOCIAL_PUBLISH_WEBHOOK_URL to have
# lib/payload/hooks/publishToSocialWebhook.ts POST {title, url, excerpt,
# imageId, publishedAt} to it on every draft -> published transition — point
# it at a Zapier/Make/n8n webhook trigger to fan out to actual social
# platforms from there (their OAuth, not this app's).
# ---------------------------------------------------------------------------
SOCIAL_PUBLISH_WEBHOOK_URL=

NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# The /admin hub's "Storybook" card links here — Storybook runs as its own
# separate process (`pnpm storybook`, port 6006 locally), not embedded in
# this Next.js app. Point this at a deployed Storybook URL (e.g. Chromatic)
# in production; defaults to the local dev server if unset.
NEXT_PUBLIC_STORYBOOK_URL=http://localhost:6006

# ---------------------------------------------------------------------------
# Analytics — nightly snapshot job (app/api/cron/analytics/route.ts,
# scheduled via vercel.json). CRON_SECRET authenticates the request; Vercel
# sets it automatically in production, generate your own for local testing.
# ANALYTICS_TIMEZONE controls what counts as "yesterday" when the job runs —
# defaults to UTC. vercel.json's cron `schedule` is always UTC regardless of
# this value; the two need to be set consistently per project.
# ---------------------------------------------------------------------------
CRON_SECRET=
ANALYTICS_TIMEZONE=UTC
