// App-layer data — everything domain-agnostic-but-not-content: audit log,
// form results, users/permissions, AI prompt config, analytics. Content
// lives in Payload's `payload` schema instead (see payload.config.ts and
// docs/decisions.md). Each project forked from this toolkit adds its own
// business-entity models here, in this same `app` schema, alongside these.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app"]
}

enum PermissionStatus {
  Active
  Archived

  @@schema("app")
}

model User {
  id            String           @id @default(uuid())
  email         String           @unique
  name          String?
  // Only set for users who log in via the Credentials provider (the
  // default admin login — see auth.ts and docs/decisions.md). Null for
  // users who only ever authenticate via an external provider like Entra
  // ID. Hashed with bcrypt — never store plaintext, never compare directly.
  password_hash String?
  // True only for whichever user account gets created first — see auth.ts's
  // signIn callback and docs/decisions.md "Bootstrap: first user is owner".
  // Bypasses the UserPermission table entirely (lib/auth/permissions.ts);
  // this toolkit doesn't hardcode a fixed role/permission set, so "grant
  // every permission" isn't expressible as rows — a coarse owner bypass is.
  is_owner      Boolean          @default(false)
  created_at    DateTime         @default(now())
  archived_at   DateTime?
  permissions   UserPermission[]

  @@map("users")
  @@schema("app")
}

// Generic role/permission shape — deliberately not a fixed enum of
// permission values. Each project defines its own permission set; this
// model just needs a string identifying which one.
model UserPermission {
  id             String           @id @default(uuid())
  user_id        String
  user           User             @relation(fields: [user_id], references: [id])
  permission     String
  status         PermissionStatus @default(Active)
  effective_from DateTime         @default(now())
  effective_to   DateTime?
  reason         String?
  created_at     DateTime         @default(now())
  archived_at    DateTime?

  @@unique([user_id, permission])
  @@map("user_permissions")
  @@schema("app")
}

// Written once, imported everywhere that mutates app-schema data — see
// docs/decisions.md "Auth/permission checking implemented once".
model AuditLog {
  id          String   @id @default(uuid())
  entity_type String
  entity_id   String
  action      String
  actor       String
  before      Json?
  after       Json?
  created_at  DateTime @default(now())

  @@map("audit_logs")
  @@schema("app")
}

// Structured form/lead capture — the reusable part of the original
// project's lead-capture pattern, without the business-specific pipeline
// (Lead → Referral, etc.) that followed it there. What happens after
// capture is project-specific and doesn't belong in this base model.
model FormSubmission {
  id          String    @id @default(uuid())
  form_key    String
  name        String?
  email       String?
  payload     Json
  source      String?
  created_at  DateTime  @default(now())
  archived_at DateTime?

  @@map("form_submissions")
  @@schema("app")
}

// Identity + a pointer at whichever AiPromptConfigVersion is currently
// live. Real history (prompt_text/model/temperature/max_tokens per save)
// lives in AiPromptConfigVersion — this model no longer carries content
// directly, so switching versions is just repointing active_version_id.
// The mutable "head" of a logical prompt (one per functional purpose). Version
// content is immutable (see AiPromptConfigVersion); this row is the git-branch
// pointer that moves: active_version_id, metadata, and the soft-delete flag all
// live here and are meant to change. Selection is by `key` (stable slug);
// `name`/`prompt_type`/`description` are human/classification metadata. See
// docs/decisions.md "AI prompt model: two-table + enriched metadata".
model AiPromptConfig {
  id                String                  @id @default(uuid())
  key               String                  @unique
  // Display name (spec field). `key` stays the stable code-facing slug.
  name              String
  // Functional purpose, e.g. "CONCIERGE". Free string (no fixed enum), matching
  // UserPermission/AnalyticsSnapshot — a fork adds values, not a Prisma enum.
  prompt_type       String                  @default("CONCIERGE")
  description       String?
  active_version_id String?                 @unique
  active_version    AiPromptConfigVersion?  @relation("ActiveVersion", fields: [active_version_id], references: [id])
  versions          AiPromptConfigVersion[] @relation("ConfigVersions")
  // Audit. *_by hold a User id or a reserved actor token like "system" (String,
  // not an FK — system/seed writes have no User row). Version content carries
  // its own created_by; these track the config head.
  created_by        String
  updated_by        String
  created_at        DateTime                @default(now())
  updated_at        DateTime                @updatedAt
  // Soft delete. An archived config is hidden from the admin list and treated
  // as absent at request time (getActivePrompt returns null -> concierge falls
  // back to the AI_PROVIDER default). Version history is preserved; recover by
  // clearing this column in the DB. Mirrors User.archived_at.
  archived_at       DateTime?
  archived_by       String?

  @@map("ai_prompt_configs")
  @@schema("app")
}

// One immutable row per save. `version` is monotonically increasing per
// config_id and never reused — rolling back repoints AiPromptConfig's
// active_version_id at an existing row here rather than creating a new one
// or renumbering, so "v3" always means the same snapshot.
model AiPromptConfigVersion {
  id          String          @id @default(uuid())
  config_id   String
  config      AiPromptConfig  @relation("ConfigVersions", fields: [config_id], references: [id])
  version     Int
  prompt_text String
  // Nullable generation overrides — null means "fall back to the
  // AI_PROVIDER-driven default in lib/ai/provider.ts", not zero.
  model       String?
  temperature Float?
  max_tokens  Int?
  change_note String?
  created_by  String
  created_at  DateTime        @default(now())
  // Per-version soft delete (Option C). Hides a bad/superseded version from the
  // history UI without deleting the row — conversations referencing it via
  // ai_prompt_version_id stay reproducible. The active version can never be
  // archived (roll back first); version numbers are never reused, so gaps are
  // expected. Recover by clearing archived_at in the DB.
  archived_at DateTime?
  archived_by String?
  active_for  AiPromptConfig? @relation("ActiveVersion")
  // Conversations that were served by this exact (immutable) version — the
  // structural guarantee behind reproducibility: an AiConversation's snapshot
  // reference can never drift because version rows never change.
  conversations AiConversation[]

  @@unique([config_id, version])
  @@map("ai_prompt_config_versions")
  @@schema("app")
}

model AiConversation {
  id         String   @id @default(uuid())
  session_id String
  messages   Json
  // The exact prompt version active when this conversation was recorded (the
  // spec's immutable ai_prompt_id). Nullable: conversations can exist with no
  // active prompt (concierge ran on the AI_PROVIDER default). Never rewritten
  // after creation — preserves reproducibility of past AI behavior.
  ai_prompt_version_id String?
  ai_prompt_version    AiPromptConfigVersion? @relation(fields: [ai_prompt_version_id], references: [id])
  created_at DateTime @default(now())

  @@map("ai_conversations")
  @@schema("app")
}

// Written only by app/api/cron/analytics/route.ts, read only by
// app/(app)/admin/analytics/page.tsx — never the reverse. See docs/decisions.md
// "Analytics: nightly snapshot job, dashboard never reads live tables."
// Generic (metric_key, value) shape rather than fixed columns, matching
// UserPermission's "no fixed enum" precedent — this toolkit only knows
// about its own domain-agnostic tables; a project's own business metrics
// get added as more metric_key values, not more models.
model AnalyticsSnapshot {
  id            String   @id @default(uuid())
  // Always the UTC-midnight Date for the calendar day this snapshot
  // represents, in whatever timezone ANALYTICS_TIMEZONE is configured to —
  // see the cron route for how that conversion happens.
  snapshot_date DateTime
  metric_key    String
  value         Float
  created_at    DateTime @default(now())

  @@unique([snapshot_date, metric_key])
  @@map("analytics_snapshots")
  @@schema("app")
}
