// App-layer data — everything domain-agnostic-but-not-content: audit log,
// form results, users/permissions, AI prompt config, analytics. Content
// lives in Payload's `payload` schema instead (see payload.config.ts and
// docs/decisions.md). Each project forked from this toolkit adds its own
// business-entity models here, in this same `app` schema, alongside these.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app"]
}

enum PermissionStatus {
  Active
  Archived

  @@schema("app")
}

model User {
  id            String           @id @default(uuid())
  email         String           @unique
  name          String?
  created_at    DateTime         @default(now())
  archived_at   DateTime?
  permissions   UserPermission[]

  @@map("users")
  @@schema("app")
}

// Generic role/permission shape — deliberately not a fixed enum of
// permission values. Each project defines its own permission set; this
// model just needs a string identifying which one.
model UserPermission {
  id             String            @id @default(uuid())
  user_id        String
  user           User              @relation(fields: [user_id], references: [id])
  permission     String
  status         PermissionStatus  @default(Active)
  effective_from DateTime          @default(now())
  effective_to   DateTime?
  reason         String?
  created_at     DateTime          @default(now())
  archived_at    DateTime?

  @@unique([user_id, permission])
  @@map("user_permissions")
  @@schema("app")
}

// Written once, imported everywhere that mutates app-schema data — see
// docs/decisions.md "Auth/permission checking implemented once".
model AuditLog {
  id           String   @id @default(uuid())
  entity_type  String
  entity_id    String
  action       String
  actor        String
  before       Json?
  after        Json?
  created_at   DateTime @default(now())

  @@map("audit_logs")
  @@schema("app")
}

// Structured form/lead capture — the reusable part of the original
// project's lead-capture pattern, without the business-specific pipeline
// (Lead → Referral, etc.) that followed it there. What happens after
// capture is project-specific and doesn't belong in this base model.
model FormSubmission {
  id          String   @id @default(uuid())
  form_key    String
  name        String?
  email       String?
  payload     Json
  source      String?
  created_at  DateTime @default(now())
  archived_at DateTime?

  @@map("form_submissions")
  @@schema("app")
}

model AiPromptConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  prompt_text String
  version     Int      @default(1)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("ai_prompt_configs")
  @@schema("app")
}

model AiConversation {
  id           String   @id @default(uuid())
  session_id   String
  messages     Json
  created_at   DateTime @default(now())

  @@map("ai_conversations")
  @@schema("app")
}
